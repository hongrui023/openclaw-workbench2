# ============================================================
# openclaw-workbench · 环境变量模板
#
# 用法：复制成 .env（.env 已被 .gitignore 排除，绝不会进 GitHub）
#   Windows:  copy .env.example .env
#   Mac/Linux: cp .env.example .env
#
# 这个文件里【只有占位符，没有真实值】——它是唯一进 GitHub 的配置形态。
# ============================================================

# ------------------------------------------------------------
# 认证
# ------------------------------------------------------------
# 不要在这里填明文口令。先生成哈希：
#   python scripts/make_password_hash.py
# 然后粘贴结果（形如 scrypt$16384$8$1$<salt>$<hash>）
WORKBENCH_PASSWORD_HASH=scrypt$16384$8$1$REPLACE_ME$REPLACE_ME
SESSION_DAYS=30
LOGIN_LOCKOUT_MINUTES=30

# 仅本地开发可用：设 WORKBENCH_DEV=1 时可直接用明文口令，省去反复生成哈希。
# 在 NAS 上必须保持注释状态。
# WORKBENCH_DEV=1
# 开发口令留空即可 —— scripts/dev_run.* 会在每次启动时随机生成并打印在终端。
# WORKBENCH_PASSWORD=

# ------------------------------------------------------------
# OpenClaw 适配层
# ------------------------------------------------------------
# ★ 最容易踩的两个坑，都要看：
#   ① 容器里的 127.0.0.1 指的是【容器自己】，不是 NAS → 必须填 NAS 的局域网 IP。
#   ② 端口要填【宿主机映射端口】，不是容器内部端口。
#      你这台极空间上是：宿主 51879 → 容器 28789，所以这里填 51879。
#
# NAS 上：  http://192.168.1.77:51879/v1
# 本地开发：http://host.docker.internal:51879/v1
# 结尾的 /v1 不能漏——客户端会自己拼 /chat/completions
OPENCLAW_BASE_URL=http://192.168.1.77:51879/v1

# OpenClaw Gateway 的访问令牌。只存在于这里和容器的环境变量里。
# 绝不进入前端、绝不进入任何 HTTP 响应、绝不截图分享。
# 取法：OpenClaw Control（http://<NAS-IP>:51879）→ Config → gateway → auth
#   mode = "token"    → 复制 gateway.auth.token 的值
#   mode = "password" → 复制 gateway.auth.password 的值
# 两种模式在这里都填成同一个 Bearer 值，工作台会自动用对。
OPENCLAW_TOKEN=

# 发给 OpenClaw 的 model 字段。
# ★ 这一项最反直觉：OpenClaw 把它解释成【agent 目标】，不是后端模型名。
#   所以不要填 deepseek/deepseek-v4-flash —— 那是 OpenClaw 内部的后端模型，
#   由 OpenClaw 自己管，工作台不该也不需要知道。
#   openclaw/default 是官方文档点名的"稳定别名"，永远指向配置好的默认 agent，
#   即使你以后改了默认 agent 的名字也不会失效。
#   只有当它返回 400 时，才改用 openclaw:<某个具体 agent 名>。
OPENCLAW_MODEL=openclaw/default

# 可选：用请求头显式指定 agent 时填这里（用 model 字段指定时留空即可）
OPENCLAW_AGENT_ID=

# 单次模型调用超时（秒）。长文献单块的输入可能很大，不要设太小。
OPENCLAW_TIMEOUT_SECONDS=300

# ------------------------------------------------------------
# 长文献分段参数
# ------------------------------------------------------------
# 你的模型 contextWindow = 1,000,000，48000 字符/块留有充足余量。
# ≤ CHUNK_MAX_CHARS 的文献走【直通模式】（1 次调用），超过才分段。
CHUNK_MAX_CHARS=48000
CHUNK_OVERLAP_CHARS=800

# 归并分组大小：中间小结多于这个份数时，按此分组先做中级归并
REDUCE_FAN_IN=6

# 分块数上限。超过则判定为异常文档（如整本电子书）并明确报告失败。
MAX_CHUNKS=60

# ------------------------------------------------------------
# 资源与限制
# ------------------------------------------------------------
MAX_PDF_MB=100
MAX_PDF_PAGES=500

# 网页上查看一份分析结果时最多返回多少字符（超出部分截断并标注）
MARKDOWN_VIEW_MAX_CHARS=40000

# ------------------------------------------------------------
# 挂载路径（docker compose 用；极空间界面里手填）
# ------------------------------------------------------------
# Windows 开发示例：
#   LITERATURE_DIR=C:/Users/Admin/workbench-data/literature
#   LIFE_NOTES_DIR=C:/Users/Admin/workbench-data/life_notes
# NAS 上填极空间里的实际路径
LITERATURE_DIR=./literature
LIFE_NOTES_DIR=./life_notes
PROMPTS_DIR=./prompts

# ------------------------------------------------------------
# 其他
# ------------------------------------------------------------
TZ=Asia/Shanghai
WORKBENCH_LOG_LEVEL=INFO
