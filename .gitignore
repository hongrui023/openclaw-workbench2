# ============================================================
# openclaw-workbench · .gitignore
#
# 这张清单是"GitHub 只存代码与配置模板、绝不存私人数据与真实 Token"
# 的【技术兜底】。不要依赖自觉，不要在提交时用 -f 绕过。
# ============================================================

# --- 真实机密（只存在于 NAS 容器的环境变量里）---
.env
.env.*
!.env.example
*.token
token.txt

# --- 私人数据（绝不允许出现在仓库里）---
data/
literature/
life_notes/
*.pdf
*.md.bak
daily_notes.md
workbench_log.md

# --- 运行期产物 ---
var/
*.log
logs/

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# --- 编辑器 / 系统 ---
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
